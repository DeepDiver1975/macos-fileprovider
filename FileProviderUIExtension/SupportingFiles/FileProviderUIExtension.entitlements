<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FileProviderUI extension entitlements (progress.md Task 1.3).

  Sandboxed; shares the same app group and keychain group as the File Provider
  extension and the containing app so the sign-in UI can store credentials the
  extension later reads. network.client is present because the sign-in flow
  performs the OIDC / basic-auth probe itself.

  The app group id MUST keep the $(AppIdentifierPrefix) prefix — unprefixed, an
  extension is silently denied the container (see the note in
  FileProviderExtension.entitlements and OwnCloudCore/AppGroup.swift).
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)group.com.owncloud.macos.fileprovider</string>
    </array>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.owncloud.macos.fileprovider.shared</string>
    </array>
</dict>
</plist>
