# Pinned backend versions (progress.md AC-7). A backend upgrade is a reviewable
# change to this one file. The oCIS binary used on macOS MUST match OCIS_VERSION
# so the end-to-end tier and the backend-contract tier exercise the same server.
CLASSIC_IMAGE=owncloud/server:11.0.0
OCIS_VERSION=8.2.0
OCIS_IMAGE=owncloud/ocis:8.2.0
