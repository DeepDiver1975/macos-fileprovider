<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Containing app Info.plist (progress.md Task 1.2). The app is a plain macOS
  application bundle that embeds the two .appex extensions in its
  Contents/PlugIns. No NSExtension key here — only the extensions carry one.
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>ownCloud File Provider</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <!--
      Task 7.9: the sandboxed FileProviderUI extension cannot host sign-in, so on
      a re-authentication error it opens the containing app at the failing
      account via this custom scheme (OwnCloudCore.AppLaunchURL.scheme). The app
      handles the URL in onOpenURL and presents that account's sign-in. Keeping
      the scheme string here in sync with AppLaunchURL.scheme is the one manual
      coupling; the URL grammar itself is unit-tested in AppLaunchURLTests.
    -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.owncloud.macos.fileprovider.reconnect</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>owncloud-fileprovider</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
