<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  File Provider (non-UI) extension Info.plist.

  NSExtensionPointIdentifier = com.apple.fileprovider-nonui is the value Xcode's
  "File Provider Extension" target template writes. It is NOT enumerated in
  Apple's NSExtensionPointIdentifier documentation (see progress.md Task 1.2);
  reconfirm against the .xctemplate inside Xcode.app before relying on it — a
  wrong identifier signs cleanly and then never loads.

  NSExtensionPrincipalClass points at the NSFileProviderReplicatedExtension
  conformer (Phase 4). Xcode fills the $(PRODUCT_MODULE_NAME) variable at build.
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>ownCloud File Provider</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <!--
      Issue #18. Which bundle macOS reads for the Finder sidebar's sync-root icon
      is undocumented, so the app and both extensions all carry the same icon from
      the shared Resources/Assets.xcassets. This target additionally needs
      ASSETCATALOG_COMPILER_APPICON_NAME in project.yml — an .appex does not get
      that setting for free the way the app target does.
    -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>XPC!</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.fileprovider-nonui</string>
        <key>NSExtensionPrincipalClass</key>
        <string>$(PRODUCT_MODULE_NAME).FileProviderExtension</string>
        <!--
          REQUIRED: without this key fileproviderd logs
          '"NSExtensionFileProviderDocumentGroup" key not found in Info.plist.
          Skipping provider' and NSFileProviderManager.add(domain:) then fails
          with NSFileProviderErrorProviderNotFound (-2001). The value must be an
          app group shared by the app and this extension — it matches the
          com.apple.security.application-groups entitlement on both.
        -->
        <key>NSExtensionFileProviderDocumentGroup</key>
        <string>group.com.owncloud.macos.fileprovider</string>
        <!--
          REQUIRED for a replicated (V3) extension. Without it the system starts
          the extension on the legacy V2 code path and aborts in
          __FILEPROVIDER_V2_EXTENSION_WITHOUT_IMPL (SIGABRT) the moment
          fileproviderd calls beginRequestWithDomain:, crash-looping the process
          so the domain never materialises and Finder shows nothing. Present in
          Xcode's File Provider Extension template; surfaced as
          'supports enumeration: 1' in `fileproviderctl dump`.
        -->
        <key>NSExtensionFileProviderSupportsEnumeration</key>
        <true/>
        <!--
          Task 7.9: opts into Finder-native "Remove Download" (eviction) with no
          code. Undocumented by Apple; read from Nextcloud's shipping
          FileProviderExt/Info.plist and corroborated by the eviction scenarios
          in the tst_vfs seed group (progress.md appendix). Behaviour to be
          reconfirmed on a Mac under Task 7.0(d) — a wrong assumption here only
          affects whether the menu item appears, not correctness of sync.
        -->
        <key>NSExtensionFileProviderAllowsUserControlledEviction</key>
        <true/>
    </dict>
</dict>
</plist>
